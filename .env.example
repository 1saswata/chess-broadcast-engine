# .env.example
# ---------------------------------------------------------
# INSTRUCTIONS: Copy this file to '.env' before running docker compose.
# DO NOT commit your actual '.env' file to version control.
# ---------------------------------------------------------

# PostgreSQL Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=chessdb

# Internal Docker Network URLs (Used by the Go containers)
# Note how the DB_URL matches the credentials defined above
DB_URL="postgres://admin:supersecretpassword@postgres:5432/chessdb?sslmode=disable"
AMQP_SERVER_URL="amqp://guest:guest@rabbitmq:5672/"
REDIS_URL="redis:6379"

# OpenTelemetry / Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT="http://jaeger:4318"